<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Storage</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="12.4.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Admin dashboard pages -->
    <None Remove="Web\**\*" />
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin's own strings the pages use, in every language Jellyfin has -->
    <JellyfinString Include="All" />
    <JellyfinString Include="HeaderLibraries" />
    <JellyfinString Include="LabelAvailable" />
    <JellyfinString Include="Folders" />
    <JellyfinString Include="LabelDevice" />
    <JellyfinString Include="LabelFolder" />
    <JellyfinString Include="LabelStatus" />
    <JellyfinString Include="LabelSystem" />
    <JellyfinString Include="LabelType" />
    <JellyfinString Include="Refresh" />
    <JellyfinString Include="LabelSize" />
    <JellyfinString Include="Settings" />
    <JellyfinString Include="Alerts" />
    <JellyfinString Include="Off" />
    <JellyfinString Include="Save" />
    <JellyfinString Include="None" />
    <JellyfinString Include="External" />
    <JellyfinString Include="StorageType.Network" />
    <JellyfinString Include="Name" />
    <JellyfinString Include="LabelWeb" />
    <JellyfinString Include="LabelLogs" />
    <JellyfinString Include="LabelMetadata" />
    <JellyfinString Include="LabelCache" />
    <JellyfinString Include="LabelTranscodes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local strings whose English matches a Jellyfin string with another meaning -->
    <JellyfinTextMatch Include="HeaderFormat" />
    <JellyfinTextMatch Include="LabelSpace" />
  </ItemGroup>

</Project>
